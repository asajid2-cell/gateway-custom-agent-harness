#!/usr/bin/env bash
# The POSIX entry point for the gateway launcher; scripts/cc.ps1 is the Windows
# one. This is a thin shim so the launcher itself can be plain node: the harness
# spawns this file directly to prewarm or start a partner, and an executable
# script with a shebang is what spawn() can run without being told the runtime.
#
# node is resolved defensively rather than assumed on PATH, because the places
# this is launched from - a login shell, a launchd job, a partner spawned by a
# session - do not all carry the same PATH.
set -euo pipefail

# Resolve this script's real location, following symlinks. The natural way to put
# `cc` on PATH is a symlink into ~/.local/bin, and dirname of that symlink is not
# where the launcher lives - so follow the chain first.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  src_dir="$(cd -P -- "$(dirname -- "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in
    /*) ;;
    *) src="$src_dir/$src" ;;
  esac
done
here="$(cd -P -- "$(dirname -- "$src")" && pwd)"

# An installed copy ships its own environment in install.env: the bundled vault
# and a vault directory that belongs to this copy. Apply it before the runtime
# resolution so an install never inherits another session's credentials.
if [ -f "$here/../install.env" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ''|'#'*) continue ;;
      *=*)
        name="${line%%=*}"
        value="${line#*=}"
        case "$name" in
          [A-Za-z_]*)
            case "$name" in
              *[!A-Za-z0-9_]*) ;;
              *) export "$name=$value" ;;
            esac
            ;;
        esac
        ;;
    esac
  done < "$here/../install.env"
fi

# A packaged artifact carries its own runtime, and an install must work on a
# machine with neither node nor bun on PATH. A source checkout has no runtime/
# directory, so it resolves node exactly as before.
runner=""
if [ -x "$here/../runtime/bun" ]; then
  runner="$here/../runtime/bun"
fi
if [ -z "$runner" ]; then
  runner="${CC_NODE:-}"
  runner="${runner:-$(command -v node 2>/dev/null || true)}"
  if [ -z "$runner" ]; then
    for candidate in "$HOME/.local/bin/node" /usr/local/bin/node /opt/homebrew/bin/node; do
      if [ -x "$candidate" ]; then runner="$candidate"; break; fi
    done
  fi
fi
if [ -z "$runner" ]; then
  runner="$(command -v bun 2>/dev/null || true)"
fi
if [ -z "$runner" ]; then
  echo "cc: a JavaScript runtime is required; neither the bundled runtime, node, nor bun was found." >&2
  exit 1
fi

exec "$runner" "$here/cc-launcher.mjs" "$@"
